{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "来源配置候选契约",
 "$comment": "评审草案 0.1.0；未获业务批准。整体为 Q10/Q12/Q13 的设计候选。S2 §11 是建议字段表，不是已确认的通用强制 schema；额外字段明确写在 description。",
 "type": "object",
 "properties": {
  "resource_kind": {
   "enum": [
    "news",
    "law",
    "statistics",
    "general"
   ],
   "description": "T015 候选扩展：资料类型决定增量策略（新闻按发布、法规查哈希、统计按版本）；Q13 未决前不改变启用范围"
  },
  "update_policy": {
   "type": "object",
   "description": "T015 候选扩展：KR-012 七类建议频率的逐来源覆盖；未配置时不做周期判定",
   "properties": {
    "key": {
     "enum": [
      "A",
      "B",
      "C",
      "D",
      "E",
      "F",
      "G"
     ]
    },
    "period_days": {
     "type": "integer",
     "minimum": 1
    },
    "triggers": {
     "type": "array",
     "items": {
      "enum": [
       "major_document",
       "new_law",
       "historical_backfill",
       "boundary_change"
      ]
     }
    }
   },
   "required": [
    "key"
   ],
   "additionalProperties": false
  },
  "source_id": {
   "type": "string",
   "minLength": 1,
   "description": "来源标识"
  },
  "source_name": {
   "type": "string",
   "minLength": 1,
   "description": "来源名称"
  },
  "base_domain": {
   "type": "string",
   "minLength": 1,
   "description": "不含协议的域名"
  },
  "country": {
   "type": "string",
   "description": "S2 注册表国家"
  },
  "authority_level": {
   "enum": [
    "A1",
    "A2",
    "B",
    "C"
   ]
  },
  "categories": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "A—G 候选类别；映射待 Q02"
  },
  "allowed_paths": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": ""
  },
  "blocked_paths": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": ""
  },
  "crawl_mode": {
   "type": "string",
   "description": ""
  },
  "update_interval": {
   "type": "string",
   "description": "可读策略；正式调度语法待选"
  },
  "parser_type": {
   "type": "string",
   "description": ""
  },
  "language": {
   "type": "string",
   "description": ""
  },
  "stance_default": {
   "enum": [
    "CN_OFFICIAL",
    "IN_OFFICIAL",
    "BILATERAL",
    "NEUTRAL"
   ]
  },
  "robots_policy": {
   "type": "string",
   "description": "规则和核验结果"
  },
  "terms_checked_at": {
   "type": "string",
   "format": "date-time"
  },
  "last_success_at": {
   "type": "string",
   "format": "date-time"
  },
  "last_content_hash": {
   "type": "string",
   "pattern": "^[0-9a-fA-F]{64}$"
  },
  "error_count": {
   "type": "integer",
   "minimum": 0
  },
  "owner": {
   "type": "string",
   "description": ""
  },
  "allowed_domains": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "S1 §3.4，合并为配置是候选",
   "minItems": 1
  },
  "enabled": {
   "type": "boolean",
   "description": "本次候选字段，示例关闭"
  },
  "seed_terms": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "S2 建议通常 8—15 个常规词；测试词另记"
  },
  "supplement_terms": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "候选补漏词字段"
  },
  "exclude_terms": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "候选排除词字段"
  },
  "request_rate_per_second": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "max_concurrency": {
   "type": "integer",
   "minimum": 1
  },
  "connect_timeout_seconds": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "read_timeout_seconds": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "max_retries": {
   "type": "integer",
   "minimum": 0
  },
  "entry_urls": {
   "type": "array",
   "items": {
    "type": "string",
    "format": "uri"
   },
   "description": "T004 设计补充：该来源的已核验入口 URL；真实取值待 Q12/Q13 核验后填入"
  },
  "search_url_template": {
   "type": "string",
   "description": "T004 设计补充：含 {query} 占位符的站内搜索地址模板；真实取值待逐站核验"
  },
  "adapter": {
   "type": "object",
   "description": "T026 设计补充（候选，待 T002 冻结）：逐来源适配规则；缺省时使用通用发现/正文规则。规则未命中由流程显式记录（跳过或失败账），不静默回退。",
   "properties": {
    "list_link_selector": {
     "type": "string",
     "description": "列表页文档链接的 CSS 选择器；与通用范围二选一"
    },
    "list_link_pattern": {
     "type": "string",
     "description": "文档 URL 正则（在链接入边界判定前过滤）"
    },
    "pagination_selector": {
     "type": "string",
     "description": "下一页控件 CSS 选择器；命中即该来源的分页终止条件"
    },
    "max_pages": {
     "type": "integer",
     "minimum": 1,
     "description": "该来源列表分页抓取上限（覆盖通用上限）"
    },
    "content_selector": {
     "type": "string",
     "description": "详情页正文范围 CSS 选择器；未命中记录 adapter_selector_miss 失败"
    }
   },
   "additionalProperties": false
  }
 },
 "required": [
  "source_id",
  "source_name",
  "base_domain",
  "allowed_domains",
  "enabled"
 ],
 "additionalProperties": true
}
